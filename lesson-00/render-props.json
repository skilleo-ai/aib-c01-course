    {
      "id": "m0-aib-audience-landscape",
      "type": "content-image",
      "templateId": "bullets-visual-architecture-focus",
      "templateFamily": "BULLETS_VISUAL",
      "title": "Who is this certification for?",
      "script": "This is for people who lead or influence AI outcomes: product and program managers, business leaders, analysts, consultants, and marketing or sales professionals. You do not have to build the models yourself. AWS recommends basic AI familiarity and six months alongside AI initiatives. Coding, implementation experience, and another certification are not required. AI Practitioner validates foundational AI concepts and AWS AI service knowledge. Business Strategist focuses on choosing investments, building business cases, managing risk, and driving adoption. Earning both is optional.",
      "bullets": [
        "Business and cross-functional roles",
        "AI familiarity; no coding prerequisite",
        "Different purpose from AI Practitioner"
      ],
      "durationSec": 53.233333333333334,
